# Set this once your Google AdSense application is approved — enables Auto
# ads sitewide (the base script in layout.tsx). Also set it in Vercel's
# project Environment Variables for the live site.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Provision a Postgres database in Vercel (Storage tab -> Neon integration),
# link it to this project, then `vercel env pull .env.local` to get this.
# Run `npm run db:init-comments` after deploying the admin_sessions migration.
# DATABASE_URL=postgres://...

# Server-only administrator authentication. Never use NEXT_PUBLIC_* for these.
# ADMIN_USERNAME=admin@example.com
# ADMIN_PASSWORD_HASH=  # bcrypt cost 12; generate with scripts/hash-admin-password.mjs
# ADMIN_AUTH_PEPPER=    # openssl rand -hex 32
# ADMIN_TOTP_ENCRYPTION_KEY= # openssl rand -hex 32; keep separate from the pepper

# NOT a Vercel/app env var — used only by .github/workflows/daily-blog-post.yml.
# Set this as a GitHub repo secret instead: repo Settings -> Secrets and
# variables -> Actions -> New repository secret -> ANTHROPIC_API_KEY.
# Get a key at console.anthropic.com. Used by npm run blog:generate.
